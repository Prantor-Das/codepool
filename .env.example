# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
BETTER_AUTH_SECRET="secret"
BETTER_AUTH_URL=http://localhost:3000
# Optional browser override; leave unset to use the current origin.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Register `${BETTER_AUTH_URL}/api/auth/callback/github` in the GitHub OAuth app.
