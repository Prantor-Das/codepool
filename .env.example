# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
BETTER_AUTH_SECRET="secret"
BETTER_AUTH_URL=http://localhost:3000
# Optional browser override; leave unset to use the current origin.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Public HTTPS URL used by GitHub to deliver pull request webhooks.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Secret used to sign and verify GitHub webhook payloads.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# Required only for asynchronous AI review/indexing.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
# Used for AI-generated PR reviews via ModelScope's Qwen3.5-27B.
MODELSCOPE_API_KEY=your_modelscope_api_key
PINECONE_DB_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index
# Repository Memory Graph connection.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
# Sandbox execution is opt-in. Ordinary reviews work without Daytona.
SANDBOX_PROVIDER=
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# Prepared snapshot with Docker/Compose, Node, curl, cached images and dependencies.
# Snapshot allocations must be <= 2 CPUs, 4 GiB memory, 20 GiB disk.
DAYTONA_TEMPLATE_SNAPSHOT=
DAYTONA_COMPOSE_TEMPLATE=docker-compose.yml
DAYTONA_APP_PORT=3000
DAYTONA_NETWORK_BLOCK_ALL=true
# Only this VM-local Compose service is allowed. Redis is also VM-local.
DAYTONA_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
# Production workers download exact-SHA GitHub tarballs on the trusted control plane.
# No checkout tokens or signed URLs are sent to sandboxes.
# Optional standalone verification manifest: {"<40-char SHA>":{"url":"https://...","expiresAt":"ISO time <=10m","sha256":"<64 hex>"}}
DAYTONA_REPO_ARCHIVES_JSON=
DAYTONA_VERIFY_BASE_SHA=
DAYTONA_VERIFY_PR_SHA=
# Local fallback only; repository-owned .codepool/sandbox.json is preferred.
SANDBOX_FIXTURE_SNAPSHOT=module/execution/seed/fixtures/codepool-v1.sql
SANDBOX_FIXTURE_VERSION=v1
SANDBOX_SCENARIOS_JSON=[{"id":"health-check","method":"GET","path":"/api/health","iterations":3},{"id":"home","method":"GET","path":"/","iterations":3},{"id":"login-page","method":"GET","path":"/login","iterations":3}]
# JSON cassette file used by the local fallback; an empty array is fail-closed.
DAYTONA_REPLAY_CASSETTE=module/execution/traffic/fixtures/codepool-v1.json
# Register `${BETTER_AUTH_URL}/api/auth/callback/github` in the GitHub OAuth app.
