# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
BETTER_AUTH_SECRET="secret"
BETTER_AUTH_URL=http://localhost:3000
# Optional browser override; leave unset to use the current origin.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Public HTTPS URL used by GitHub to deliver pull request webhooks.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Secret used to sign and verify GitHub webhook payloads.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# Required only for asynchronous AI review/indexing.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
# Used for AI-generated PR reviews via ModelScope's Qwen3.5-27B.
MODELSCOPE_API_KEY=your_modelscope_api_key
PINECONE_DB_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index
# Repository Memory Graph connection.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
# Sandbox Diff Engine provider. Keep unset for the NotImplemented provider.
SANDBOX_PROVIDER=daytona
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=your_daytona_target
# Repository checkout inputs for the sandbox only; use a short-lived, read-only token or signed archive URL.
DAYTONA_REPO_URL=https://github.com/owner/repository.git
DAYTONA_REPO_SLUG=owner-repository
DAYTONA_CHECKOUT_TOKEN=short_lived_read_only_checkout_token
# Prefer DAYTONA_REPO_ARCHIVE_URL with a {sha} placeholder when available.
DAYTONA_REPO_ARCHIVE_URL=
DAYTONA_COMPOSE_TEMPLATE=docker-compose.yml
# This snapshot must contain git, Docker Engine, and the Docker Compose plugin.
DAYTONA_TEMPLATE_SNAPSHOT=daytona-vm-small
DAYTONA_APP_PORT=3000
DAYTONA_CPU=2
DAYTONA_MEMORY_GB=4
DAYTONA_DISK_GB=20
DAYTONA_OPERATION_TIMEOUT_SECONDS=300
DAYTONA_EXECUTION_TIMEOUT_SECONDS=120
DAYTONA_REQUEST_TIMEOUT_MS=600000
DAYTONA_AUTO_STOP_MINUTES=30
DAYTONA_TTL_MINUTES=45
# Required: two separate sandbox-scoped Upstash Redis endpoints prevent cross-branch state leakage.
DAYTONA_UPSTASH_REDIS_REST_URL_BASE=
DAYTONA_UPSTASH_REDIS_REST_TOKEN_BASE=
DAYTONA_UPSTASH_REDIS_REST_URL_PR=
DAYTONA_UPSTASH_REDIS_REST_TOKEN_PR=
# Register `${BETTER_AUTH_URL}/api/auth/callback/github` in the GitHub OAuth app.
